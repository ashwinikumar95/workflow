{
  "jiraKey": "MF",
  "kind": "app",
  "linkedProfile": "QUT",
  "enabled": true,
  "eligibleJql": "project = MF AND assignee = currentUser() AND status in (\"To Do\",\"Open\",\"Reopened\",\"Ready for Assign\")",
  "transitions": {
    "claim": "In Progress",
    "review": "READY FOR REVIEW",
    "blocked": "On Hold"
  },
  "repo": {
    "location": "D:/Projects/MT_FUJI/FE/Fuji-Vue3",
    "defaultBranch": "main",
    "github": { "owner": "Vxceed-IN", "repo": "Fuji-Vue3" },
    "credentialRef": "GITHUB_TOKEN",
    "credentialFiles": [".env"],
    "installCommand": ["npm", "ci"],
    "appCommand": ["npx", "vite", "--port", "5182", "--strictPort"],
    "readiness": "/",
    "testCommand": [],
    "moduleRoot": "",
    "gates": [["npm", "run", "lint"], ["npm", "run", "build"]]
  },
  "rules": { "forceInclude": [], "extraDocs": [] },
  "moduleMap": {
    "rules": [{ "match": "src/views/LoadOut.vue", "modules": ["Load Out"] }],
    "autoKebabFromViews": true,
    "sharedPaths": ["src/router/**", "src/stores/**", "src/components/globalComponents/**", "package.json"],
    "sharedFallback": ["-g", "@sanity"]
  },
  "agent": { "model": "composer-2.5", "maxFixAttempts": 2 },
  "approvalExpiryHours": 24
}
